# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# ── DB (AWS RDS PostgreSQL, fridge 스키마) ─────────────
# 로컬 개발: scripts/tunnel.sh 로 터널을 열고 localhost:5433 으로 접속
# EC2 서버: PG_HOST=RDS 주소, PG_PORT=5432
PG_HOST=localhost
PG_PORT=5433
PG_DB=vibedb
PG_USER=fridge_app
PG_PASSWORD=
PG_SCHEMA=fridge

# ── 로컬 개발용 SSH 터널 (scripts/tunnel.sh) ───────────
TUNNEL_SSH_KEY=~/.ssh/<EC2 키 파일>.pem
TUNNEL_EC2=ec2-user@<EC2 주소>
TUNNEL_RDS_HOST=<RDS 주소>

# ── Claude API (Phase 2부터) ──────────────────────────
ANTHROPIC_API_KEY=
