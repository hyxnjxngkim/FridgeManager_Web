[Unit]
Description=FridgeManager Streamlit app
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/fridge-manager
# 비밀값은 /home/ec2-user/fridge-manager/.env 에서 앱이 직접 읽어요
ExecStart=/home/ec2-user/fridge-manager/.venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
