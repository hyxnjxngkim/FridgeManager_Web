# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# Supabase 프로젝트 > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것)
ANTHROPIC_API_KEY=

# 레시피 임베딩용 API (Phase 3에서 사용)
EMBEDDING_API_KEY=
